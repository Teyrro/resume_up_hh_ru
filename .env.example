# Скопируйте в .env и заполните: cp .env.example .env

# hh.ru
HH_LOGIN_EMAIL=you@gmail.com
# hash резюме через запятую (из адреса https://hh.ru/resume/<hash>)
HH_RESUME_IDS=

# Почта для кодов входа (Gmail: пароль приложения, 16 символов без пробелов)
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=you@gmail.com
IMAP_PASSWORD=
MAIL_SENDER_FILTER=hh.ru

# Telegram (необязательно)
TG_BOT_TOKEN=
TG_CHAT_ID=

TZ=Asia/Novosibirsk
DATA_DIR=/data

# Необязательные настройки (значения по умолчанию)
# HH_BASE_URL=https://hh.ru
# IMAP_FOLDER=INBOX
# HEADLESS=1
# CODE_WAIT_SECONDS=180
# MIN_INTERVAL_MINUTES=240
# JITTER_MIN_MINUTES=5
# JITTER_MAX_MINUTES=180
# MAX_LOGINS_PER_DAY=3
